! ==============================================================================
! Generated Cisco IOS Configuration: {{ dev.name }}
! Template: distribution_switch.j2 | Pipeline: NetDevOps Jinja2 Generator
! Disaster-Resilient Smart Hospital Network
! ==============================================================================
version 15.0
service password-encryption
no service timestamps log datetime msec
no service timestamps debug datetime msec
no service config
!
hostname {{ dev.name }}
!
boot-start-marker
boot-end-marker
!
enable secret 5 {{ global.enable_secret }}
!
no ip domain-lookup
ip domain-name {{ global.domain_name }}
!
username {{ global.admin_user }} privilege 15 secret 5 {{ global.admin_secret }}
!
ip routing
!
vtp mode transparent
!
{% for v in vlans %}
vlan {{ v.id }}
 name {{ v.name }}
!
{% endfor %}
spanning-tree mode {{ dev.stp_mode }}
{% if dev.stp_roots %}
{% for vid in dev.stp_roots.primary %}
spanning-tree vlan {{ vid }} root primary
{% endfor %}
{% for vid in dev.stp_roots.secondary %}
spanning-tree vlan {{ vid }} root secondary
{% endfor %}
{% endif %}
!
{% for intf in dev.interfaces %}
interface {{ intf.name }}
 description {{ intf.description }}
 no switchport
 ip address {{ intf.ip }} {{ intf.mask }}
 no shutdown
!
{% endfor %}
{% for svi in dev.svis %}
interface Vlan{{ svi.vlan }}
 description Gateway SVI for VLAN {{ svi.vlan }}
 ip address {{ svi.ip }} {{ svi.mask }}
 {% if svi.helper_address %}ip helper-address {{ svi.helper_address }}{% endif %}
 {% if svi.hsrp_group %}
 standby {{ svi.hsrp_group }} ip {{ svi.hsrp_vip }}
 standby {{ svi.hsrp_group }} priority {{ svi.hsrp_priority }}
 {% if svi.hsrp_preempt %}standby {{ svi.hsrp_group }} preempt{% endif %}
 {% endif %}
 no shutdown
!
{% endfor %}
router ospf {{ global.ospf_process_id }}
 router-id {{ dev.router_id }}
 log-adjacency-changes
 {% for net in dev.ospf.networks %}
 network {{ net }}
 {% endfor %}
 {% for p_intf in dev.ospf.passive_interfaces %}
 passive-interface {{ p_intf }}
 {% endfor %}
!
ip classless
ip ssh version {{ global.ssh_version }}
!
banner motd ^C
================================================================================
{{ global.banner_motd }}
================================================================================
^C
!
line con 0
 exec-timeout 5 0
 logging synchronous
 login local
line vty 0 4
 exec-timeout 5 0
 logging synchronous
 login local
 transport input ssh
line vty 5 15
 exec-timeout 5 0
 logging synchronous
 login local
 transport input ssh
!
end
